{
  "name": "rezonevpn-dashboard-demo",
  "version": "0.6.3",
  "private": true,
  "description": "RezoneVPN interface prototype with refreshed launcher UI and updater",
  "main": "main.cjs",
  "author": "RezoneVPN",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "release:win": "electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.rezonevpn.dashboard.demo",
    "productName": "RezoneVPN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "styles.css",
      "renderer.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/rezonevpn.ico",
      "artifactName": "RezoneVPN-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": {
      "provider": "github",
      "owner": "Rexaonygrief",
      "repo": "123123123sdfs"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
